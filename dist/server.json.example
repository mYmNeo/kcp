{
        "listen": ":29900-29999",
        "tcp": false,
        "carriermaxstreams": 0,
        "carriermaxstreamstotal": 0,
        "carrierqueuedepth": 0,
        "target": "127.0.0.1:2000",
        "key": "PASSWORD",
        "crypt": "aes-128",
        "mode": "fast3",
        "mtu": 1400,
        "ratelimit": 104857600,
        "sndwnd": 2048,
        "rcvwnd": 2048,
        "datashard": 10,
        "parityshard": 3,
        "dscp": 46,
        "nocomp": true,
        "acknodelay": false,
        "nodelay": 1,
        "interval": 40,
        "resend": 2,
        "nc": 1,
        "sockbuf": 16777217,
        "smuxver": 2,
        "smuxbuf": 16777217,
        "streambuf": 2097152,
        "keepalive": 10,
        "pprof":false,
        "quiet":false
}
